# Server
PORT=3000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/quickjobs?retryWrites=true&w=majority

# JWT — use a long random string, e.g.: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN_USER=7d
JWT_EXPIRES_IN_ADMIN=1d

# Session — use a long random string, e.g.: openssl rand -hex 32
SESSION_SECRET=replace_with_a_long_random_session_secret

# Email (SMTP app password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Superadmin seed (used by backend/seed.js only — delete after first run)
SUPERADMIN_NAME=SuperAdmin
SUPERADMIN_EMAIL=superadmin@yourdomain.com
SUPERADMIN_PASSWORD=ChangeMe_At_Least_12_Chars!

# Gemini AI (optional — AI features degrade gracefully without it)
GEMINI_API_KEY=your_gemini_api_key

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# CORS — comma-separated list of trusted origins allowed to make
# credentialed requests to this API. Local dev origins (localhost:5173/5174)
# are added automatically when NODE_ENV is not "production", so you
# generally only need to set this for UAT/production, e.g.:
#   UAT:        CORS_ALLOWED_ORIGINS=https://uat.example.com
#   Production: CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
# Never include "*" — this API sends credentials (cookies/session), and
# browsers reject a wildcard origin on credentialed requests anyway.
CORS_ALLOWED_ORIGINS=