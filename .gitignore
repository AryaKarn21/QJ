# Dependencies
node_modules/

# Environment variables — never commit these, including the .example
# templates (per explicit instruction: keep env files out of the repo
# entirely, not just the ones holding real secrets)
.env
.env.*
*.local

# Build output
dist/
build/

# User-uploaded content (backend/uploads/ — gitignored at the backend
# level too; kept here as well since git init is at the repo root)
uploads/

# Logs
*.log
npm-debug.log*

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
